datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("student")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  spaces       Space[]
  projects     Project[]
  quizAttempts QuizAttempt[]
  assessments  AssessmentAttempt[]
  masteryLogs  MasteryHistory[]
  activities   ActivityEvent[]
  aiLogs       AiLog[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Space {
  id          String    @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Project {
  id              String             @id @default(uuid())
  name            String
  description     String?
  learningGoal    String
  spaceId         String
  space           Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials       Material[]
  concepts        Concept[]
  conversations   Conversation[]
  quizzes         Quiz[]
  assessments     AssessmentAttempt[]
  recommendations Recommendation[]
  activities      ActivityEvent[]
  aiLogs          AiLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([spaceId])
}

model Material {
  id           String          @id @default(uuid())
  name         String
  filePath     String
  fileSizeBytes Int            @default(0)
  pageCount    Int             @default(0)
  status       String          @default("QUEUED")
  errorMessage String?
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks       MaterialChunk[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([projectId])
}

model MaterialChunk {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  pageNumber Int
  chunkIndex Int
  content    String
  embedding  String
  createdAt  DateTime @default(now())

  @@index([materialId])
}

model Concept {
  id            String         @id @default(uuid())
  name          String
  description   String
  masteryScore  Float          @default(0.0)
  status        String         @default("NEEDS_ATTENTION")
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  masteryLogs   MasteryHistory[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId])
}

model MasteryHistory {
  id            String   @id @default(uuid())
  conceptId     String
  concept       Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Float
  previousScore Float
  delta         Float
  reason        String
  createdAt     DateTime @default(now())

  @@index([conceptId])
  @@index([userId])
}

model Conversation {
  id        String        @id @default(uuid())
  title     String        @default("Tutor Session")
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  citations      String?
  isUnsupported  Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Quiz {
  id        String         @id @default(uuid())
  title     String
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  createdAt DateTime       @default(now())

  @@index([projectId])
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  quiz          Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  conceptId     String
  concept       Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  type          String
  prompt        String
  options       String?
  correctAnswer String?
  explanation   String?
  rubric        String?

  @@index([quizId])
  @@index([conceptId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Float
  answers   String
  createdAt DateTime @default(now())

  @@index([quizId])
  @@index([userId])
}

model AssessmentAttempt {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId     String?
  prompt        String
  studentAnswer String
  score         Float
  feedback      String
  strengths     String?
  weaknesses    String?
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

model Recommendation {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  conceptId String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ActivityEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type        String
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model AiLog {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  feature          String
  model            String
  latencyMs        Int
  promptTokens     Int
  completionTokens Int
  totalTokens      Int      @default(0)
  estimatedCost    Float
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model EvaluationRun {
  id         String             @id @default(uuid())
  name       String
  status     String             @default("COMPLETED")
  passCount  Int                @default(0)
  failCount  Int                @default(0)
  totalCount Int                @default(0)
  durationMs Int                @default(0)
  details    String?
  results    EvaluationResult[]
  createdAt  DateTime           @default(now())
}

model EvaluationResult {
  id           String        @id @default(uuid())
  runId        String
  run          EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  testName     String
  category     String
  status       String
  score        Float         @default(1.0)
  input        String
  expected     String
  actual       String
  latencyMs    Int
  errorMessage String?
  createdAt    DateTime      @default(now())

  @@index([runId])
}
